<Window x:Class="MiniAVDecoder.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        mc:Ignorable="d"
        Title="MiniAV 直播与媒体工具"
        Height="760"
        Width="1180"
        MinHeight="680"
        MinWidth="1040"
        Background="#F8FCFE"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#607D8B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,16,10"/>
        </Style>

        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2F0F6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="MinWidth" Value="108"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6"/>
        </Style>

        <Style x:Key="CompactButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#345D70"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="LogTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#FCFEFF"/>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="LiveVideoViewBoxStyle" TargetType="Viewbox">
            <Setter Property="Stretch" Value="Uniform"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding LiveScaleMode}" Value="自动缩放">
                    <Setter Property="Stretch" Value="UniformToFill"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainRoot" Background="#F8FCFE" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="AppHeaderPanel" Margin="2,0,0,18">
            <TextBlock x:Name="AppTitleText"
                       Text="MiniAV 直播与媒体工具"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="#345D70"/>
            <TextBlock Text="推流、播放与媒体分析"
                       FontSize="13"
                       Foreground="#88A5B2"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <TabControl x:Name="MainTabControl"
                    Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0">
            <TabItem Header="直播推流">
                <Grid Background="Transparent" Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource PanelBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="推流地址" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Column="1"
                                     Grid.ColumnSpan="2"
                                     Text="{Binding RtmpUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="1" Text="视频来源" Style="{StaticResource FieldLabelStyle}"/>
                            <StackPanel Grid.Row="1"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Orientation="Horizontal"
                                        Margin="0,0,0,8">
                                <RadioButton Content="摄像头模式"
                                             IsChecked="{Binding IsCameraMode}"
                                             GroupName="VideoSourceMode"
                                             VerticalAlignment="Center"
                                             Margin="0,0,18,0"/>
                                <RadioButton Content="共享视频模式"
                                             IsChecked="{Binding IsSharedVideoMode}"
                                             GroupName="VideoSourceMode"
                                             VerticalAlignment="Center"
                                             Margin="0,0,18,0"/>
                                <ComboBox Width="280"
                                          Height="32"
                                          ItemsSource="{Binding CameraDevices}"
                                          SelectedItem="{Binding CameraDeviceName, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsCameraMode}"
                                          ToolTip="摄像头模式下选择视频采集设备"
                                          Margin="0,0,10,0"/>
                                <Button Content="刷新摄像头"
                                        Width="110"
                                        Height="32"
                                        IsEnabled="{Binding IsCameraMode}"
                                        Style="{StaticResource CompactButtonStyle}"
                                        Command="{Binding ListLiveDevicesCommand}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Text="音频来源" Style="{StaticResource FieldLabelStyle}"/>
                            <CheckBox Grid.Row="2"
                                      Grid.Column="1"
                                      Content="推送麦克风声音"
                                      IsChecked="{Binding IncludeAudio}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,12,8"/>
                            <TextBox Grid.Row="2"
                                     Grid.Column="2"
                                     Text="{Binding AudioDeviceName, UpdateSourceTrigger=PropertyChanged}"
                                     Width="260"
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,0,8"
                                     ToolTip="麦克风设备名，例如 Microphone Array"/>

                            <TextBlock Grid.Row="3" Text="推流参数" Style="{StaticResource FieldLabelStyle}"/>
                            <StackPanel Grid.Row="3"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Orientation="Horizontal"
                                        Margin="0,0,0,10">
                                <TextBlock Text="分辨率" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox Width="110"
                                          Height="32"
                                          ItemsSource="{Binding LiveVideoSizeOptions}"
                                          SelectedItem="{Binding LiveVideoSize, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,18,8"/>
                                <TextBlock Text="帧率" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox Width="75"
                                          Height="32"
                                          ItemsSource="{Binding LiveFrameRateOptions}"
                                          SelectedItem="{Binding LiveFrameRate, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,18,8"/>
                                <TextBlock Text="码率kbps" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox Width="95"
                                          Height="32"
                                          ItemsSource="{Binding LiveVideoBitrateOptions}"
                                          SelectedItem="{Binding LiveVideoBitrateKbps, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,8"/>
                            </StackPanel>

                            <StackPanel Grid.Row="4"
                                        Grid.ColumnSpan="3"
                                        Orientation="Horizontal">
                                <Button Content="开始直播"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding StartLiveCommand}"/>
                                <Button Content="停止直播"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding StopLiveCommand}"/>
                                <ProgressBar Width="180"
                                             Height="10"
                                             IsIndeterminate="True"
                                             Visibility="{Binding IsLiveStreaming, Converter={StaticResource BoolToVisibility}}"
                                             Margin="8,0,0,0"
                                             VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding LiveStatusText}"
                                           Foreground="#667085"
                                           Margin="14,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="直播日志"
                                       Style="{StaticResource SectionTitleStyle}"/>
                            <TextBox Grid.Row="1"
                                     Style="{StaticResource LogTextBoxStyle}"
                                     Text="{Binding LiveLogText, Mode=OneWay}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="观看直播">
                <Grid x:Name="PlaybackPageGrid" Background="Transparent" Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="PlaybackControlRow" Height="Auto"/>
                        <RowDefinition x:Name="PlaybackSpacerRow" Height="14"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition x:Name="PlaybackLogRow" Height="150"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="PlaybackControlPanel" Style="{StaticResource PanelBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="播放地址" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding PlaybackUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="开始播放"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding StartPlaybackCommand}"/>
                                <Button Content="停止播放"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding StopPlaybackCommand}"/>
                                <TextBlock Text="画面比例"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Margin="4,0,8,0"/>
                                <ComboBox Width="110"
                                          Height="32"
                                          ItemsSource="{Binding LiveScaleModeOptions}"
                                          SelectedItem="{Binding LiveScaleMode, UpdateSourceTrigger=PropertyChanged}"
                                          VerticalContentAlignment="Center"
                                          Margin="0,0,10,0"/>
                                <Button Content="全屏"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="OnToggleFullscreenButtonClick"/>
                                <TextBlock Text="{Binding PlaybackStatusText}"
                                           Foreground="#667085"
                                           VerticalAlignment="Center"
                                           Margin="4,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="PlaybackVideoBorder"
                            Grid.Row="2"
                            Background="#101216"
                            BorderBrush="#D9DEE7"
                            BorderThickness="1"
                            CornerRadius="6"
                            MouseDown="OnPlaybackVideoMouseDown">
                        <vlc:VideoView x:Name="LiveVideoView"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       HorizontalContentAlignment="Stretch"
                                       VerticalContentAlignment="Stretch"/>
                    </Border>

                    <Border x:Name="PlaybackLogPanel"
                            Grid.Row="3"
                            Style="{StaticResource PanelBorderStyle}"
                            Margin="0,14,0,0"
                            Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="播放日志"
                                       Style="{StaticResource SectionTitleStyle}"/>
                            <TextBox Grid.Row="1"
                                     Style="{StaticResource LogTextBoxStyle}"
                                     Text="{Binding PlaybackLogText, Mode=OneWay}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="媒体分析">
                <Grid Background="Transparent" Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource PanelBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="视频文件" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="True"
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,12,8"/>
                            <Button Grid.Column="2"
                                    Content="选择视频"
                                    Width="110"
                                    Height="32"
                                    Margin="0,0,0,8"
                                    Style="{StaticResource CompactButtonStyle}"
                                    Command="{Binding ChooseVideoCommand}"/>

                            <TextBlock Grid.Row="1" Text="输出目录" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,12,8"/>
                            <StackPanel Grid.Row="1"
                                        Grid.Column="2"
                                        Orientation="Horizontal"
                                        Margin="0,0,0,8">
                                <Button Content="选择目录"
                                        Width="110"
                                        Height="32"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource CompactButtonStyle}"
                                        Command="{Binding ChooseOutputCommand}"/>
                                <Button Content="打开目录"
                                        Width="110"
                                        Height="32"
                                        Style="{StaticResource CompactButtonStyle}"
                                        Command="{Binding OpenOutputCommand}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2"
                                        Grid.ColumnSpan="3"
                                        Orientation="Horizontal">
                                <Button Content="分析"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding AnalyzeCommand}"/>
                                <Button Content="抽取帧"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding ExtractFramesCommand}"/>
                                <Button Content="提取音频"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding ExtractAudioCommand}"/>
                                <Button Content="全部执行"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="0,0,18,0"
                                        Command="{Binding RunAllCommand}"/>
                                <TextBlock Text="帧数" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Width="64"
                                         Height="34"
                                         Text="{Binding FrameCount, UpdateSourceTrigger=LostFocus}"
                                         VerticalContentAlignment="Center"/>
                                <ProgressBar Width="180"
                                             Height="10"
                                             IsIndeterminate="True"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                                             Margin="18,0,0,0"
                                             VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StatusText}"
                                           Foreground="#667085"
                                           Margin="14,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource PanelBorderStyle}" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="日志和报告"
                                           Style="{StaticResource SectionTitleStyle}"/>
                                <TextBox Grid.Row="1"
                                         Style="{StaticResource LogTextBoxStyle}"
                                         Text="{Binding LogText, Mode=OneWay}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="帧预览"
                                           Style="{StaticResource SectionTitleStyle}"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding FramePreviews}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#D9DEE7"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Margin="0,0,10,10"
                                                        Padding="4">
                                                    <Image Source="{Binding}"
                                                           Width="154"
                                                           Height="88"
                                                           Stretch="Uniform"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
