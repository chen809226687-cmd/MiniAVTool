<Window x:Class="MiniAVDecoder.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MiniAVDecoder"
        Height="720"
        Width="1120"
        MinHeight="620"
        MinWidth="980">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Grid Background="#F5F7FA" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="MiniAVDecoder"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="#18202F"
                   Margin="0,0,0,14"/>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#D9DEE7"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14"
                Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Video file"
                           VerticalAlignment="Center"
                           Foreground="#394354"
                           Margin="0,0,12,8"/>
                <TextBox Grid.Column="1"
                         Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="True"
                         Height="32"
                         VerticalContentAlignment="Center"
                         Margin="0,0,12,8"/>
                <Button Grid.Column="2"
                        Content="Choose video"
                        Width="110"
                        Height="32"
                        Margin="0,0,0,8"
                        Command="{Binding ChooseVideoCommand}"/>

                <TextBlock Grid.Row="1"
                           Text="Output folder"
                           VerticalAlignment="Center"
                           Foreground="#394354"
                           Margin="0,0,12,8"/>
                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                         Height="32"
                         VerticalContentAlignment="Center"
                         Margin="0,0,12,8"/>
                <StackPanel Grid.Row="1"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            Margin="0,0,0,8">
                    <Button Content="Choose folder"
                            Width="110"
                            Height="32"
                            Margin="0,0,8,0"
                            Command="{Binding ChooseOutputCommand}"/>
                    <Button Content="Open folder"
                            Width="110"
                            Height="32"
                            Command="{Binding OpenOutputCommand}"/>
                </StackPanel>

                <StackPanel Grid.Row="2"
                            Grid.ColumnSpan="3"
                            Orientation="Horizontal">
                    <Button Content="Analyze"
                            Width="110"
                            Height="34"
                            Margin="0,0,10,0"
                            Command="{Binding AnalyzeCommand}"/>
                    <Button Content="Extract frames"
                            Width="110"
                            Height="34"
                            Margin="0,0,10,0"
                            Command="{Binding ExtractFramesCommand}"/>
                    <Button Content="Extract audio"
                            Width="110"
                            Height="34"
                            Margin="0,0,10,0"
                            Command="{Binding ExtractAudioCommand}"/>
                    <Button Content="Run all"
                            Width="110"
                            Height="34"
                            Margin="0,0,18,0"
                            Command="{Binding RunAllCommand}"/>
                    <TextBlock Text="Frames"
                               VerticalAlignment="Center"
                               Foreground="#394354"
                               Margin="0,0,8,0"/>
                    <TextBox Width="64"
                             Height="34"
                             Text="{Binding FrameCount, UpdateSourceTrigger=PropertyChanged}"/>
                    <ProgressBar Width="180"
                                 Height="10"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                                 Margin="18,0,0,0"
                                 VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="#667085"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Background="White"
                    BorderBrush="#D9DEE7"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Log and report"
                               FontWeight="SemiBold"
                               Foreground="#18202F"
                               Margin="0,0,0,10"/>
                    <TextBox Grid.Row="1"
                             Text="{Binding LogText, Mode=OneWay}"
                             FontFamily="Consolas"
                             FontSize="13"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#D9DEE7"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Frame preview"
                               FontWeight="SemiBold"
                               Foreground="#18202F"
                               Margin="0,0,0,10"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FramePreviews}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#D9DEE7"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Margin="0,0,10,10"
                                            Padding="4">
                                        <Image Source="{Binding}"
                                               Width="154"
                                               Height="88"
                                               Stretch="Uniform"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
