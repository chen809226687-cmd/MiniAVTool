<Window x:Class="MiniAVDecoder.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        mc:Ignorable="d"
        Title="MiniAV 直播与媒体工具"
        Height="760"
        Width="1180"
        MinHeight="680"
        MinWidth="1040">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#394354"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,8"/>
        </Style>

        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D9DEE7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </Window.Resources>

    <Grid Background="#F5F7FA" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="MiniAV 直播与媒体工具"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="#18202F"
                   Margin="0,0,0,14"/>

        <TabControl Grid.Row="1">
            <TabItem Header="直播推流">
                <Grid Background="#F5F7FA" Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource PanelBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="推流地址" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Column="1"
                                     Grid.ColumnSpan="2"
                                     Text="{Binding RtmpUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="1" Text="视频来源" Style="{StaticResource FieldLabelStyle}"/>
                            <CheckBox Grid.Row="1"
                                      Grid.Column="1"
                                      Content="使用摄像头"
                                      IsChecked="{Binding UseCamera}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,12,8"/>
                            <StackPanel Grid.Row="1"
                                        Grid.Column="2"
                                        Orientation="Horizontal"
                                        Margin="0,0,0,8">
                                <TextBox Text="{Binding CameraDeviceName, UpdateSourceTrigger=PropertyChanged}"
                                         Width="260"
                                         Height="32"
                                         VerticalContentAlignment="Center"
                                         Margin="0,0,10,0"
                                         ToolTip="摄像头设备名，例如 Integrated Camera"/>
                                <Button Content="列出设备"
                                        Width="110"
                                        Height="32"
                                        Command="{Binding ListLiveDevicesCommand}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Text="音频来源" Style="{StaticResource FieldLabelStyle}"/>
                            <CheckBox Grid.Row="2"
                                      Grid.Column="1"
                                      Content="推送麦克风声音"
                                      IsChecked="{Binding IncludeAudio}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,12,8"/>
                            <TextBox Grid.Row="2"
                                     Grid.Column="2"
                                     Text="{Binding AudioDeviceName, UpdateSourceTrigger=PropertyChanged}"
                                     Width="260"
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,0,8"
                                     ToolTip="麦克风设备名，例如 Microphone Array"/>

                            <TextBlock Grid.Row="3" Text="推流参数" Style="{StaticResource FieldLabelStyle}"/>
                            <StackPanel Grid.Row="3"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Orientation="Horizontal"
                                        Margin="0,0,0,10">
                                <TextBlock Text="分辨率" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Width="100"
                                         Height="32"
                                         Text="{Binding LiveVideoSize, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"
                                         Margin="0,0,18,8"/>
                                <TextBlock Text="帧率" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Width="70"
                                         Height="32"
                                         Text="{Binding LiveFrameRate, UpdateSourceTrigger=LostFocus}"
                                         VerticalContentAlignment="Center"
                                         Margin="0,0,18,8"/>
                                <TextBlock Text="码率kbps" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Width="90"
                                         Height="32"
                                         Text="{Binding LiveVideoBitrateKbps, UpdateSourceTrigger=LostFocus}"
                                         VerticalContentAlignment="Center"
                                         Margin="0,0,0,8"/>
                            </StackPanel>

                            <StackPanel Grid.Row="4"
                                        Grid.ColumnSpan="3"
                                        Orientation="Horizontal">
                                <Button Content="开始直播"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding StartLiveCommand}"/>
                                <Button Content="停止直播"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding StopLiveCommand}"/>
                                <ProgressBar Width="180"
                                             Height="10"
                                             IsIndeterminate="True"
                                             Visibility="{Binding IsLiveStreaming, Converter={StaticResource BoolToVisibility}}"
                                             Margin="8,0,0,0"
                                             VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding LiveStatusText}"
                                           Foreground="#667085"
                                           Margin="14,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="直播日志"
                                       FontWeight="SemiBold"
                                       Foreground="#18202F"
                                       Margin="0,0,0,10"/>
                            <TextBox Grid.Row="1"
                                     Text="{Binding LiveLogText, Mode=OneWay}"
                                     FontFamily="Consolas"
                                     FontSize="13"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="观看直播">
                <Grid Background="#F5F7FA" Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="150"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource PanelBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="播放地址" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding PlaybackUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="开始播放"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding StartPlaybackCommand}"/>
                                <Button Content="停止播放"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding StopPlaybackCommand}"/>
                                <TextBlock Text="{Binding PlaybackStatusText}"
                                           Foreground="#667085"
                                           VerticalAlignment="Center"
                                           Margin="4,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Background="#101216"
                            BorderBrush="#D9DEE7"
                            BorderThickness="1"
                            CornerRadius="6">
                        <vlc:VideoView x:Name="LiveVideoView"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"/>
                    </Border>

                    <Border Grid.Row="3"
                            Style="{StaticResource PanelBorderStyle}"
                            Margin="0,14,0,0"
                            Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="播放日志"
                                       FontWeight="SemiBold"
                                       Foreground="#18202F"
                                       Margin="0,0,0,8"/>
                            <TextBox Grid.Row="1"
                                     Text="{Binding PlaybackLogText, Mode=OneWay}"
                                     FontFamily="Consolas"
                                     FontSize="13"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="媒体分析">
                <Grid Background="#F5F7FA" Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource PanelBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="视频文件" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="True"
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,12,8"/>
                            <Button Grid.Column="2"
                                    Content="选择视频"
                                    Width="110"
                                    Height="32"
                                    Margin="0,0,0,8"
                                    Command="{Binding ChooseVideoCommand}"/>

                            <TextBlock Grid.Row="1" Text="输出目录" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,12,8"/>
                            <StackPanel Grid.Row="1"
                                        Grid.Column="2"
                                        Orientation="Horizontal"
                                        Margin="0,0,0,8">
                                <Button Content="选择目录"
                                        Width="110"
                                        Height="32"
                                        Margin="0,0,8,0"
                                        Command="{Binding ChooseOutputCommand}"/>
                                <Button Content="打开目录"
                                        Width="110"
                                        Height="32"
                                        Command="{Binding OpenOutputCommand}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2"
                                        Grid.ColumnSpan="3"
                                        Orientation="Horizontal">
                                <Button Content="分析"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding AnalyzeCommand}"/>
                                <Button Content="抽取帧"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding ExtractFramesCommand}"/>
                                <Button Content="提取音频"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding ExtractAudioCommand}"/>
                                <Button Content="全部执行"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="0,0,18,0"
                                        Command="{Binding RunAllCommand}"/>
                                <TextBlock Text="帧数" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Width="64"
                                         Height="34"
                                         Text="{Binding FrameCount, UpdateSourceTrigger=LostFocus}"
                                         VerticalContentAlignment="Center"/>
                                <ProgressBar Width="180"
                                             Height="10"
                                             IsIndeterminate="True"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                                             Margin="18,0,0,0"
                                             VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StatusText}"
                                           Foreground="#667085"
                                           Margin="14,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource PanelBorderStyle}" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="日志和报告"
                                           FontWeight="SemiBold"
                                           Foreground="#18202F"
                                           Margin="0,0,0,10"/>
                                <TextBox Grid.Row="1"
                                         Text="{Binding LogText, Mode=OneWay}"
                                         FontFamily="Consolas"
                                         FontSize="13"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="帧预览"
                                           FontWeight="SemiBold"
                                           Foreground="#18202F"
                                           Margin="0,0,0,10"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding FramePreviews}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#D9DEE7"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Margin="0,0,10,10"
                                                        Padding="4">
                                                    <Image Source="{Binding}"
                                                           Width="154"
                                                           Height="88"
                                                           Stretch="Uniform"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
